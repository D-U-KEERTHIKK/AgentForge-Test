<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <interviewLabel>Employee Equipment Request Wizard {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Employee Equipment Request Wizard</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <status>Draft</status>

    <!-- CHOICES -->
    <choices>
        <name>choiceNewHire</name>
        <choiceText>New Hire</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>New Hire</stringValue>
        </value>
    </choices>
    <choices>
        <name>choiceReplacement</name>
        <choiceText>Replacement</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Replacement</stringValue>
        </value>
    </choices>
    <choices>
        <name>choiceUpgrade</name>
        <choiceText>Upgrade</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Upgrade</stringValue>
        </value>
    </choices>

    <!-- FORMULA: Task Subject -->
    <formulas>
        <name>varTaskSubject</name>
        <dataType>String</dataType>
        <expression>"Equipment Fulfillment - " &amp; {!varEmployeeName}</expression>
    </formulas>

    <!-- RECORD CREATES -->
    <recordCreates>
        <name>Create_EquipmentRequest</name>
        <label>Create Equipment Request</label>
        <locationX>56</locationX>
        <locationY>1440</locationY>
        <assignRecordIdToReference>varRequestId</assignRecordIdToReference>
        <connector>
            <targetReference>Create_FulfillmentTask</targetReference>
        </connector>
        <inputAssignments>
            <field>Employee__c</field>
            <value>
                <elementReference>varEmployeeId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Justification__c</field>
            <value>
                <elementReference>varJustification</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Laptop_Required__c</field>
            <value>
                <elementReference>varLaptopRequired</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Monitor_Required__c</field>
            <value>
                <elementReference>varMonitorRequired</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Phone_Required__c</field>
            <value>
                <elementReference>varPhoneRequired</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Request_Type__c</field>
            <value>
                <elementReference>varRequestType</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Pending Approval</stringValue>
            </value>
        </inputAssignments>
        <object>Equipment_Request__c</object>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_FulfillmentTask</name>
        <label>Create Fulfillment Task</label>
        <locationX>56</locationX>
        <locationY>1620</locationY>
        <assignRecordIdToReference>varTaskId</assignRecordIdToReference>
        <connector>
            <targetReference>scrSuccess</targetReference>
        </connector>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>varTaskSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>varRequestId</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordCreates>

    <!-- RECORD LOOKUPS -->
    <recordLookups>
        <name>RecordLookup_Employee</name>
        <label>Lookup Employee</label>
        <locationX>56</locationX>
        <locationY>360</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_EmployeeName</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varEmployeeId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <outputAssignments>
            <assignToReference>varEmployee</assignToReference>
            <field>Id</field>
        </outputAssignments>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <storeOutputAutomatically>false</storeOutputAutomatically>
    </recordLookups>

    <!-- SCREENS -->
    <screens>
        <name>scrWelcome</name>
        <label>Welcome</label>
        <locationX>56</locationX>
        <locationY>180</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>RecordLookup_Employee</targetReference>
        </connector>
        <fields>
            <name>cmpEmployeeId</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>varEmployeeId</elementReference>
            </defaultValue>
            <fieldText>Employee User ID</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <outputParameters>
                <assignToReference>varEmployeeId</assignToReference>
                <name>value</name>
            </outputParameters>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>scrRequestType</name>
        <label>Request Type</label>
        <locationX>56</locationX>
        <locationY>720</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>scrEquipmentSelection</targetReference>
        </connector>
        <fields>
            <name>cmpRequestType</name>
            <choiceReferences>choiceNewHire</choiceReferences>
            <choiceReferences>choiceReplacement</choiceReferences>
            <choiceReferences>choiceUpgrade</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Request Type</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
            <outputParameters>
                <assignToReference>varRequestType</assignToReference>
                <name>value</name>
            </outputParameters>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>scrEquipmentSelection</name>
        <label>Equipment Selection</label>
        <locationX>56</locationX>
        <locationY>900</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>scrJustification</targetReference>
        </connector>
        <fields>
            <name>cmpLaptopRequired</name>
            <dataType>Boolean</dataType>
            <defaultValue>
                <elementReference>varLaptopRequired</elementReference>
            </defaultValue>
            <fieldText>Laptop Required</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <outputParameters>
                <assignToReference>varLaptopRequired</assignToReference>
                <name>value</name>
            </outputParameters>
        </fields>
        <fields>
            <name>cmpMonitorRequired</name>
            <dataType>Boolean</dataType>
            <defaultValue>
                <elementReference>varMonitorRequired</elementReference>
            </defaultValue>
            <fieldText>Monitor Required</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <outputParameters>
                <assignToReference>varMonitorRequired</assignToReference>
                <name>value</name>
            </outputParameters>
        </fields>
        <fields>
            <name>cmpPhoneRequired</name>
            <dataType>Boolean</dataType>
            <defaultValue>
                <elementReference>varPhoneRequired</elementReference>
            </defaultValue>
            <fieldText>Mobile Phone Required</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <outputParameters>
                <assignToReference>varPhoneRequired</assignToReference>
                <name>value</name>
            </outputParameters>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>scrJustification</name>
        <label>Justification</label>
        <locationX>56</locationX>
        <locationY>1080</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>scrConfirmation</targetReference>
        </connector>
        <fields>
            <name>cmpJustification</name>
            <dataType>String</dataType>
            <fieldText>Justification</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>true</isRequired>
            <outputParameters>
                <assignToReference>varJustification</assignToReference>
                <name>value</name>
            </outputParameters>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>scrConfirmation</name>
        <label>Confirmation</label>
        <locationX>56</locationX>
        <locationY>1260</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Create_EquipmentRequest</targetReference>
        </connector>
        <fields>
            <name>cmpDisplayEmployeeName</name>
            <fieldText>Employee Name: {!varEmployeeName}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>cmpDisplayRequestType</name>
            <fieldText>Request Type: {!varRequestType}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>cmpDisplayLaptopRequired</name>
            <fieldText>Laptop Required: {!varLaptopRequired}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>cmpDisplayMonitorRequired</name>
            <fieldText>Monitor Required: {!varMonitorRequired}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>cmpDisplayPhoneRequired</name>
            <fieldText>Phone Required: {!varPhoneRequired}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>cmpDisplayJustification</name>
            <fieldText>Justification: {!varJustification}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>scrSuccess</name>
        <label>Success</label>
        <locationX>56</locationX>
        <locationY>1800</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>cmpSuccessMessage</name>
            <fieldText>Equipment Request Created Successfully! Request ID: {!varRequestId}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>cmpTaskMessage</name>
            <fieldText>Fulfillment Task Created. Task ID: {!varTaskId}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>cmpApprovalMessage</name>
            <fieldText>Approval Process has been started.</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>

    <!-- START -->
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>scrWelcome</targetReference>
        </connector>
    </start>

    <!-- ASSIGNMENTS -->
    <assignments>
        <name>Assign_EmployeeName</name>
        <label>Assign Employee Name</label>
        <locationX>56</locationX>
        <locationY>540</locationY>
        <assignmentItems>
            <assignToReference>varEmployeeName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varEmployee.Name</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>scrRequestType</targetReference>
        </connector>
    </assignments>

    <!-- VARIABLES -->
    <variables>
        <name>varApprovalStatus</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varEmployee</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>User</objectType>
    </variables>
    <variables>
        <name>varEmployeeId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varEmployeeName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varJustification</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varLaptopRequired</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <name>varMonitorRequired</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <name>varPhoneRequired</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
