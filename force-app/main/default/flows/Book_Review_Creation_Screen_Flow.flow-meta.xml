<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <description>Screen Flow that guides users through entering book review details and creates a Book_Review__c record.</description>
    <isTemplate>false</isTemplate>
    <label>Book Review Creation Screen Flow</label>
    <processType>Flow</processType>
    <screens>
        <name>Book_Review_Entry_Screen</name>
        <label>Book Review Entry Screen</label>
        <locationX>176</locationX>
        <locationY>92</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <fields>
            <name>Book_Title_Input</name>
            <dataType>String</dataType>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <label>Book Title</label>
        </fields>
        <fields>
            <name>Author_Name_Input</name>
            <dataType>String</dataType>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <label>Author Name</label>
        </fields>
        <fields>
            <name>Rating_Input</name>
            <dataType>Number</dataType>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <label>Rating (1-5)</label>
            <scale>0</scale>
        </fields>
        <fields>
            <name>Review_Status_Input</name>
            <dataType>String</dataType>
            <fieldType>DropdownField</fieldType>
            <isRequired>true</isRequired>
            <label>Review Status</label>
            <choiceValues>
                <name>Draft</name>
                <specialValue>Draft</specialValue>
            </choiceValues>
            <choiceValues>
                <name>Published</name>
                <specialValue>Published</specialValue>
            </choiceValues>
            <value>
                <elementReference>Default_Review_Status</elementReference>
            </value>
        </fields>
        <fields>
            <name>Review_Notes_Input</name>
            <dataType>String</dataType>
            <fieldType>LargeTextAreaField</fieldType>
            <isRequired>false</isRequired>
            <label>Review Notes</label>
        </fields>
    </screens>
    <recordCreates>
        <name>Create_Book_Review_Record</name>
        <label>Create Book Review Record</label>
        <locationX>176</locationX>
        <locationY>272</locationY>
        <inputAssignments>
            <field>Book_Title__c</field>
            <value>
                <elementReference>Book_Title_Input</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Author_Name__c</field>
            <value>
                <elementReference>Author_Name_Input</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Rating__c</field>
            <value>
                <elementReference>Rating_Input</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Review_Status__c</field>
            <value>
                <elementReference>Review_Status_Input</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Review_Notes__c</field>
            <value>
                <elementReference>Review_Notes_Input</elementReference>
            </value>
        </inputAssignments>
        <object>Book_Review__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Book_Review_Entry_Screen</targetReference>
        </connector>
    </start>
    <variables>
        <name>Default_Review_Status</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Draft</stringValue>
        </value>
    </variables>
    <decisions>
        <name>Finish_Flow</name>
        <label>Finish Flow</label>
        <locationX>176</locationX>
        <locationY>392</locationY>
        <defaultConnectorLabel>Continue</defaultConnectorLabel>
        <rules>
            <name>End_Flow</name>
            <conditionLogic>and</conditionLogic>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>End</targetReference>
            </connector>
            <label>End Flow</label>
        </rules>
    </decisions>
    <description>Screen Flow for creating Book Review records with user input validation.</description>
</Flow>