<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <description>Screen flow for creating Book Review records with input fields for title, author, rating, status, and notes.</description>
    <interviewLabel>Book Review Creation Screen Flow</interviewLabel>
    <isTemplate>false</isTemplate>
    <label>Book Review Creation Screen Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <screens>
        <name>Book_Review_Input_Screen</name>
        <label>Book Review Input Screen</label>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
        <fields>
            <name>Book_Title_Input</name>
            <fieldType>InputField</fieldType>
            <inputType>Text</inputType>
            <isRequired>true</isRequired>
            <label>Book Title</label>
            <locationX>0</locationX>
            <locationY>0</locationY>
            <referenceNameOnScreen>Book_Title_Input</referenceNameOnScreen>
        </fields>
        <fields>
            <name>Author_Name_Input</name>
            <fieldType>InputField</fieldType>
            <inputType>Text</inputType>
            <isRequired>true</isRequired>
            <label>Author Name</label>
            <locationX>0</locationX>
            <locationY>100</locationY>
            <referenceNameOnScreen>Author_Name_Input</referenceNameOnScreen>
        </fields>
        <fields>
            <name>Rating_Input</name>
            <fieldType>InputField</fieldType>
            <inputType>Number</inputType>
            <isRequired>true</isRequired>
            <label>Rating</label>
            <locationX>0</locationX>
            <locationY>200</locationY>
            <referenceNameOnScreen>Rating_Input</referenceNameOnScreen>
            <scale>0</scale>
        </fields>
        <fields>
            <name>Review_Status_Input</name>
            <fieldType>InputField</fieldType>
            <inputType>Picklist</inputType>
            <isRequired>true</isRequired>
            <label>Review Status</label>
            <locationX>0</locationX>
            <locationY>300</locationY>
            <referenceNameOnScreen>Review_Status_Input</referenceNameOnScreen>
        </fields>
        <fields>
            <name>Review_Notes_Input</name>
            <fieldType>InputField</fieldType>
            <inputType>LongTextArea</inputType>
            <isRequired>false</isRequired>
            <label>Review Notes</label>
            <locationX>0</locationX>
            <locationY>400</locationY>
            <referenceNameOnScreen>Review_Notes_Input</referenceNameOnScreen>
        </fields>
    </screens>
    <recordCreates>
        <name>Create_Book_Review</name>
        <label>Create Book Review</label>
        <locationX>50</locationX>
        <locationY>200</locationY>
        <connector>
            <targetReference>Success_Screen</targetReference>
        </connector>
        <inputAssignments>
            <field>Book_Title__c</field>
            <value>
                <elementReference>Book_Title_Input</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Author_Name__c</field>
            <value>
                <elementReference>Author_Name_Input</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Rating__c</field>
            <value>
                <elementReference>Rating_Input</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Review_Status__c</field>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Review_Notes__c</field>
            <value>
                <elementReference>Review_Notes_Input</elementReference>
            </value>
        </inputAssignments>
        <object>Book_Review__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <screens>
        <name>Success_Screen</name>
        <label>Success Screen</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
        <fields>
            <name>Success_Message</name>
            <fieldType>DisplayText</fieldType>
            <label>Success Message</label>
            <locationX>0</locationX>
            <locationY>0</locationY>
            <value>
                <stringValue>Book review created successfully!</stringValue>
            </value>
        </fields>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Book_Review_Input_Screen</targetReference>
        </connector>
    </start>
    <status>Active</status>
</Flow>