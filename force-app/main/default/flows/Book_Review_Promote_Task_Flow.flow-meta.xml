<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <decisions>
        <name>Check_Promotion_Criteria</name>
        <label>Check Promotion Criteria</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <defaultConnectorLabel>No Action</defaultConnectorLabel>
        <rules>
            <name>Criteria_Met</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Rating__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>4.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Review_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Published</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Promotion_Task</targetReference>
            </connector>
            <label>Criteria Met</label>
        </rules>
    </decisions>
    <description>Record-Triggered Flow to create a promotion task when a Book Review is created or updated with a rating of 4 or higher and Published status.</description>
    <interviewLabel>Book Review Promote Task Flow</interviewLabel>
    <isTemplate>false</isTemplate>
    <label>Book_Review_Promote_Task_Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LowCodeCloud</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LowCodeCloud</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <triggerType>RecordAfterSave</triggerType>
    <recordCreateConfigs>
        <name>Create_Promotion_Task</name>
        <label>Create Promotion Task</label>
        <locationX>440</locationX>
        <locationY>240</locationY>
        <connector>
            <targetReference>Success_Path</targetReference>
        </connector>
        <object>Task</object>
        <recordUpdates>
            <name>Set_Task_Subject</name>
            <fieldName>Subject</fieldName>
            <value>
                <stringValue>Promote Book Review</stringValue>
            </value>
        </recordUpdates>
        <recordUpdates>
            <name>Set_Task_OwnerId</name>
            <fieldName>OwnerId</fieldName>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </recordUpdates>
        <recordUpdates>
            <name>Set_Task_WhatId</name>
            <fieldName>WhatId</fieldName>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </recordUpdates>
        <recordUpdates>
            <name>Set_Task_Status</name>
            <fieldName>Status</fieldName>
            <value>
                <stringValue>Not Started</stringValue>
            </value>
        </recordUpdates>
        <recordUpdates>
            <name>Set_Task_Priority</name>
            <fieldName>Priority</fieldName>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </recordUpdates>
    </recordCreateConfigs>
    <start>
        <locationX>50</locationX>
        <locationY>240</locationY>
        <connector>
            <targetReference>Check_Promotion_Criteria</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <triggerType>RecordAfterSave</triggerType>
    <trigger>
        <object>Book_Review__c</object>
        <triggerEvents>CREATE</triggerEvents>
        <triggerEvents>UPDATE</triggerEvents>
    </trigger>
    <variables>
        <name>Success_Path</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Success</stringValue>
        </value>
    </variables>
</Flow>
