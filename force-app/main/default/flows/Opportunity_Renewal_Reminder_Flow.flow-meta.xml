<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <definition>
        <actionCalls>
            <name>Send_Renewal_Reminder_Email</name>
            <label>Send Renewal Reminder Email</label>
            <locationX>176</locationX>
            <locationY>432</locationY>
            <actionName>standard_sendEmail</actionName>
            <actionType>apex</actionType>
            <connector>
                <targetReference>Update_Renewal_Reminder_Sent</targetReference>
            </connector>
            <flowTransactionModel>CurrentTransaction</flowTransactionModel>
            <inputParameters>
                <name>emailAlert</name>
                <value>
                    <stringValue>Opportunity_Renewal_Reminder_Email_Alert</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>relatedRecordId</name>
                <value>
                    <elementReference>opportunityLoop.Id</elementReference>
                </value>
            </inputParameters>
        </actionCalls>
        <actionCalls>
            <name>Create_Task_for_Owner</name>
            <label>Create Task for Owner</label>
            <locationX>176</locationX>
            <locationY>540</locationY>
            <actionName>quickCreate</actionName>
            <actionType>quickCreate</actionType>
            <connector>
                <targetReference>Update_Renewal_Reminder_Sent</targetReference>
            </connector>
            <flowTransactionModel>CurrentTransaction</flowTransactionModel>
            <inputParameters>
                <name>objectApiName</name>
                <value>
                    <stringValue>Task</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>fields</name>
                <value>
                    <elementReference>taskFieldsOwner</elementReference>
                </value>
            </inputParameters>
        </actionCalls>
        <actionCalls>
            <name>Create_Task_for_Manager</name>
            <label>Create Task for Manager</label>
            <locationX>528</locationX>
            <locationY>864</locationY>
            <actionName>quickCreate</actionName>
            <actionType>quickCreate</actionType>
            <connector>
                <targetReference>Call_Escalation_Logger</targetReference>
            </connector>
            <flowTransactionModel>CurrentTransaction</flowTransactionModel>
            <inputParameters>
                <name>objectApiName</name>
                <value>
                    <stringValue>Task</stringValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>fields</name>
                <value>
                    <elementReference>taskFieldsManager</elementReference>
                </value>
            </inputParameters>
        </actionCalls>
        <actionCalls>
            <name>Call_Escalation_Logger</name>
            <label>Call Escalation Logger</label>
            <locationX>528</locationX>
            <locationY>972</locationY>
            <actionName>RenewalEscalationLogger</actionName>
            <actionType>apex</actionType>
            <connector>
                <targetReference>opportunityLoop</targetReference>
            </connector>
            <flowTransactionModel>CurrentTransaction</flowTransactionModel>
            <inputParameters>
                <name>requests</name>
                <value>
                    <elementReference>escalationRequest</elementReference>
                </value>
            </inputParameters>
        </actionCalls>
        <collectionProcessors>
            <name>opportunityLoop</name>
            <elementType>SObject</elementType>
            <isActive>true</isActive>
            <collectionReference>queryOpportunities</collectionReference>
            <sortOrders>
                <isAscending>false</isAscending>
                <sortField>CreatedDate</sortField>
            </sortOrders>
            <nextValueConnector>
                <targetReference>Check_Escalation_Criteria</targetReference>
            </nextValueConnector>
        </collectionProcessors>
        <decisions>
            <name>Check_Escalation_Criteria</name>
            <label>Check Escalation Criteria</label>
            <locationX>352</locationX>
            <locationY>324</locationY>
            <defaultConnector>
                <targetReference>opportunityLoop</targetReference>
            </defaultConnector>
            <rules>
                <name>Escalate_If_Seven_Days_Passed</name>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>opportunityLoop.First_Reminder_Date__c</leftValueReference>
                    <operator>IsNull</operator>
                    <rightValue>
                        <booleanValue>false</booleanValue>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>opportunityLoop.First_Reminder_Date__c</leftValueReference>
                    <operator>LessThanOrEqualTo</operator>
                    <rightValue>
                        <elementReference>sevenDaysAgo</elementReference>
                    </rightValue>
                </conditions>
                <connector>
                    <targetReference>Get_Opportunity_Owner_Manager</targetReference>
                </connector>
                <label>Escalate If Seven Days Passed</label>
            </rules>
        </decisions>
        <decisions>
            <name>Has_Manager</name>
            <label>Has Manager</label>
            <locationX>528</locationX>
            <locationY>756</locationY>
            <defaultConnector>
                <targetReference>opportunityLoop</targetReference>
            </defaultConnector>
            <rules>
                <name>Manager_Found</name>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>ownerManagerId</leftValueReference>
                    <operator>IsNull</operator>
                    <rightValue>
                        <booleanValue>false</booleanValue>
                    </rightValue>
                </conditions>
                <connector>
                    <targetReference>Create_Task_for_Manager</targetReference>
                </connector>
                <label>Manager Found</label>
            </rules>
        </decisions>
        <formulas>
            <name>sevenDaysAgo</name>
            <dataType>Date</dataType>
            <expression>TODAY() - 7</expression>
        </formulas>
        <recordLookups>
            <name>queryOpportunities</name>
            <label>Query Opportunities</label>
            <locationX>176</locationX>
            <locationY>216</locationY>
            <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
            <connector>
                <targetReference>opportunityLoop</targetReference>
            </connector>
            <filterLogic>and</filterLogic>
            <filters>
                <field>CloseDate</field>
                <operator>withinNext</operator>
                <value>
                    <numberValue>30</numberValue>
                </value>
            </filters>
            <filters>
                <field>StageName</field>
                <operator>notEqualTo</operator>
                <value>
                    <stringValue>Closed Won</stringValue>
                </value>
            </filters>
            <filters>
                <field>StageName</field>
                <operator>notEqualTo</operator>
                <value>
                    <stringValue>Closed Lost</stringValue>
                </value>
            </filters>
            <filters>
                <field>Renewal_Reminder_Sent__c</field>
                <operator>equalTo</operator>
                <value>
                    <booleanValue>false</booleanValue>
                </value>
            </filters>
            <object>Opportunity</object>
            <queriedFields>Id</queriedFields>
            <queriedFields>OwnerId</queriedFields>
            <queriedFields>Owner.ManagerId</queriedFields>
            <queriedFields>First_Reminder_Date__c</queriedFields>
            <sortField>CreatedDate</sortField>
            <sortOrder>Desc</sortOrder>
            <storeOutputAutomatically>true</storeOutputAutomatically>
        </recordLookups>
        <recordLookups>
            <name>Get_Opportunity_Owner_Manager</name>
            <label>Get Opportunity Owner Manager</label>
            <locationX>528</locationX>
            <locationY>432</locationY>
            <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
            <connector>
                <targetReference>Has_Manager</targetReference>
            </connector>
            <filterLogic>and</filterLogic>
            <filters>
                <field>Id</field>
                <operator>equalTo</operator>
                <value>
                    <elementReference>opportunityLoop.OwnerId</elementReference>
                </value>
            </filters>
            <object>User</object>
            <outputAssignments>
                <assignToReference>ownerManagerId</assignToReference>
                <field>ManagerId</field>
            </outputAssignments>
        </recordLookups>
        <recordUpdates>
            <name>Update_Renewal_Reminder_Sent</name>
            <label>Update Renewal Reminder Sent</label>
            <locationX>176</locationX>
            <locationY>648</locationY>
            <connector>
                <targetReference>Update_First_Reminder_Date</targetReference>
            </connector>
            <filterLogic>and</filterLogic>
            <filters>
                <field>Id</field>
                <operator>equalTo</operator>
                <value>
                    <elementReference>opportunityLoop.Id</elementReference>
                </value>
            </filters>
            <inputAssignments>
                <field>Renewal_Reminder_Sent__c</field>
                <value>
                    <booleanValue>true</booleanValue>
                </value>
            </inputAssignments>
            <object>Opportunity</object>
        </recordUpdates>
        <recordUpdates>
            <name>Update_First_Reminder_Date</name>
            <label>Update First Reminder Date</label>
            <locationX>176</locationX>
            <locationY>756</locationY>
            <connector>
                <targetReference>opportunityLoop</targetReference>
            </connector>
            <filterLogic>and</filterLogic>
            <filters>
                <field>Id</field>
                <operator>equalTo</operator>
                <value>
                    <elementReference>opportunityLoop.Id</elementReference>
                </value>
            </filters>
            <inputAssignments>
                <field>First_Reminder_Date__c</field>
                <value>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </value>
            </inputAssignments>
            <object>Opportunity</object>
        </recordUpdates>
        <start>
            <locationX>50</locationX>
            <locationY>50</locationY>
            <connector>
                <targetReference>queryOpportunities</targetReference>
            </connector>
            <filterFormula>true</filterFormula>
            <object>null</object>
            <schedule>
                <frequency>Daily</frequency>
                <startTime>00:00:00.000Z</startTime>
            </schedule>
            <triggerType>Scheduled</triggerType>
        </start>
        <variables>
            <name>ownerManagerId</name>
            <dataType>String</dataType>
            <isCollection>false</isCollection>
            <isInput>false</isInput>
            <isOutput>false</isOutput>
        </variables>
        <variables>
            <name>escalationRequest</name>
            <dataType>Apex</dataType>
            <isCollection>true</isCollection>
            <isInput>false</isInput>
            <isOutput>false</isOutput>
            <objectType>RenewalEscalationLogger.EscalationRequest</objectType>
        </variables>
        <variables>
            <name>taskFieldsOwner</name>
            <dataType>Map</dataType>
            <isCollection>false</isCollection>
            <isInput>false</isInput>
            <isOutput>false</isOutput>
            <value>
                <mapItems>
                    <key>Subject</key>
                    <value>
                        <stringValue>Renewal Reminder: {!opportunityLoop.Name}</stringValue>
                    </value>
                </mapItems>
                <mapItems>
                    <key>OwnerId</key>
                    <value>
                        <elementReference>opportunityLoop.OwnerId</elementReference>
                    </value>
                </mapItems>
                <mapItems>
                    <key>ActivityDate</key>
                    <value>
                        <elementReference>dueInThreeDays</elementReference>
                    </value>
                </mapItems>
                <mapItems>
                    <key>WhatId</key>
                    <value>
                        <elementReference>opportunityLoop.Id</elementReference>
                    </value>
                </mapItems>
                <mapItems>
                    <key>Description</key>
                    <value>
                        <stringValue>Follow up on renewal opportunity closing within 30 days.</stringValue>
                    </value>
                </mapItems>
            </value>
        </variables>
        <variables>
            <name>taskFieldsManager</name>
            <dataType>Map</dataType>
            <isCollection>false</isCollection>
            <isInput>false</isInput>
            <isOutput>false</isOutput>
            <value>
                <mapItems>
                    <key>Subject</key>
                    <value>
                        <stringValue>Escalated Renewal: {!opportunityLoop.Name}</stringValue>
                    </value>
                </mapItems>
                <mapItems>
                    <key>OwnerId</key>
                    <value>
                        <elementReference>ownerManagerId</elementReference>
                    </value>
                </mapItems>
                <mapItems>
                    <key>ActivityDate</key>
                    <value>
                        <elementReference>$Flow.CurrentDate</elementReference>
                    </value>
                </mapItems>
                <mapItems>
                    <key>WhatId</key>
                    <value>
                        <elementReference>opportunityLoop.Id</elementReference>
                    </value>
                </mapItems>
                <mapItems>
                    <key>Description</key>
                    <value>
                        <stringValue>Escalated renewal opportunity. Initial reminder sent 7+ days ago. Owner should be contacted.</stringValue>
                    </value>
                </mapItems>
            </value>
        </variables>
        <variables>
            <name>dueInThreeDays</name>
            <dataType>Date</dataType>
            <isCollection>false</isCollection>
            <isInput>false</isInput>
            <isOutput>false</isOutput>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </variables>
    </definition>
    <description>Scheduled daily Flow to manage renewal reminders and escalations. Queries opportunities closing within 30 days that are not Closed Won/Lost and haven't had a reminder sent. Sends email alert, creates task, and stamps First_Reminder_Date. For opportunities with reminders sent 7+ days ago, escalates to manager and logs escalation.</description>
    <isActive>true</isActive>
    <label>Opportunity Renewal Reminder Flow</label>
    <processMetadataValues>
        <name>BuilderVersion</name>
        <value>1</value>
    </processMetadataValues>
    <processType>AutoLaunched</processType>
</Flow>